# =============================================================================
# Klyvion — environment configuration (TEMPLATE)
# =============================================================================
# Copy this file to `.env` and adjust values for your environment.
#
#     cp .env.example .env
#
# `.env` is git-ignored and MUST NOT be committed. This template is safe to
# commit because it contains no secrets — only defaults and documentation.
#
# Every variable is optional: Klyvion falls back to the defaults shown here
# (defined in klyvion/config.py and klyvion/api/server.py). Uncomment and
# change only what you need.
# =============================================================================

# -----------------------------------------------------------------------------
# Engine & synthesis (klyvion/config.py)
# -----------------------------------------------------------------------------

# Synthesis backend.
#   xtts    -> neural, zero-shot voice cloning, 17 languages (default; ~2 GB model)
#   pyttsx3 -> lightweight offline fallback, NO cloning
KLYVION_ENGINE=xtts

# Compute device for the neural engine: auto | cpu | cuda
KLYVION_DEVICE=auto

# Default language code (English only is enabled at launch; see docs/EXTENDING_LANGUAGES.md)
KLYVION_LANGUAGE=en

# Output sample rate in Hz.
KLYVION_SAMPLE_RATE=24000

# -----------------------------------------------------------------------------
# Storage paths (klyvion/config.py)
# -----------------------------------------------------------------------------

# Where cloned-voice samples and the JSON voice index are persisted.
# Docker maps this to /data (a named volume). Locally, ~ expands to $HOME.
KLYVION_DATA_DIR=~/.klyvion

# Default directory for synthesized audio files.
KLYVION_OUTPUT_DIR=./outputs

# -----------------------------------------------------------------------------
# HTTP API server (klyvion/api/server.py)
# -----------------------------------------------------------------------------

# Maximum characters accepted per /synthesize request (protects CPU).
# Recommended for a public CPU demo: 500.
KLYVION_MAX_TEXT_LEN=1000

# Voice cloning via the API: 1 = enabled, 0 = presets-only.
# NOTE: cloned voices are currently GLOBAL across all users of an instance.
# Set to 0 for a safe public demo.
KLYVION_ENABLE_CLONING=1

# Maximum accepted upload size (MB) for voice-cloning samples.
KLYVION_MAX_UPLOAD_MB=15

# Comma-separated list of allowed CORS origins.
# `*` is fine for local dev; set your real domains in production.
KLYVION_CORS_ORIGINS=*

# -----------------------------------------------------------------------------
# Third-party / model licensing
# -----------------------------------------------------------------------------

# Coqui XTTS downloads its model on first use and requires ToS agreement.
# Setting this to 1 auto-accepts the Coqui Public Model License (non-commercial
# for the *model weights*). Only set this if you accept those terms.
COQUI_TOS_AGREED=0
