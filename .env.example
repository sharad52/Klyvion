# =============================================================================
# Klyvion — environment configuration (TEMPLATE)
# =============================================================================
# Copy this file to `.env` and adjust values for your environment.
#
#     cp .env.example .env
#
# `.env` is git-ignored and MUST NOT be committed. This template is safe to
# commit because it contains no secrets — only defaults and documentation.
#
# Every variable is optional: Klyvion falls back to the defaults shown here
# (defined in klyvion/config.py and klyvion/api/server.py). Uncomment and
# change only what you need.
# =============================================================================

# -----------------------------------------------------------------------------
# Engine & synthesis (klyvion/config.py)
# -----------------------------------------------------------------------------

# Synthesis backend.
#   xtts    -> neural, zero-shot voice cloning, 17 languages (default; ~2 GB model)
#   pyttsx3 -> lightweight offline fallback, NO cloning
KLYVION_ENGINE=xtts

# Compute device for the neural engine: auto | cpu | cuda
KLYVION_DEVICE=auto

# Default language code (English only is enabled at launch; see docs/EXTENDING_LANGUAGES.md)
KLYVION_LANGUAGE=en

# Output sample rate in Hz.
KLYVION_SAMPLE_RATE=24000

# -----------------------------------------------------------------------------
# Storage paths (klyvion/config.py)
# -----------------------------------------------------------------------------

# Where cloned-voice samples and the JSON voice index are persisted.
# Docker maps this to /data (a named volume). Locally, ~ expands to $HOME.
KLYVION_DATA_DIR=~/.klyvion

# Default directory for synthesized audio files.
KLYVION_OUTPUT_DIR=./outputs

# -----------------------------------------------------------------------------
# HTTP API server (klyvion/api/server.py)
# -----------------------------------------------------------------------------

# Maximum characters accepted per /synthesize request (protects CPU).
# Recommended for a public CPU demo: 500.
KLYVION_MAX_TEXT_LEN=1000

# Voice cloning via the API: 1 = enabled, 0 = presets-only.
# NOTE: cloned voices are currently GLOBAL across all users of an instance.
# Set to 0 for a safe public demo.
KLYVION_ENABLE_CLONING=1

# Maximum accepted upload size (MB) for voice-cloning samples.
KLYVION_MAX_UPLOAD_MB=15

# Comma-separated list of allowed CORS origins.
# `*` is fine for local dev; set your real domains in production.
KLYVION_CORS_ORIGINS=*

# -----------------------------------------------------------------------------
# Authentication & sessions (klyvion/auth/, klyvion/config.py)
# -----------------------------------------------------------------------------
# Generating and previewing audio is open to everyone; DOWNLOADING the WAV
# requires a logged-in session (username/password or Google).
#
# User accounts persist as JSON at $KLYVION_DATA_DIR/users.json via the
# JsonUserStore — there is NO database and no DATABASE_URL. A SQL/Redis backend
# would be a new UserStore subclass (see klyvion/auth/store.py), not an env var.

# HMAC secret used to sign the session-cookie JWT. THIS IS A REAL SECRET — keep
# it out of version control and set a stable, random value of >=32 characters in
# production. If unset, the server generates an ephemeral key at startup and all
# sessions are invalidated on restart. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# KLYVION_SECRET_KEY=

# Session lifetime in hours (default 168 = 7 days).
KLYVION_TOKEN_TTL_HOURS=168

# --- Google login (OPTIONAL) -------------------------------------------------
# Leave both blank to disable "Log in with Google"; username/password still
# works and the web UI hides the Google button.
#
# Create an OAuth 2.0 Client ID (type "Web application") in Google Cloud Console
# and register the redirect URI:  https://<your-host>/auth/google/callback
# (local dev: http://localhost:8000/auth/google/callback)
# KLYVION_GOOGLE_CLIENT_ID=
# KLYVION_GOOGLE_CLIENT_SECRET=

# Externally reachable base URL, used to build the Google redirect URI. If blank
# it is derived from the incoming request; set it explicitly when running behind
# a reverse proxy so the redirect matches what you registered with Google.
# KLYVION_PUBLIC_BASE_URL=https://klyvion.sharadbhandari.com.np

# -----------------------------------------------------------------------------
# Token credits & billing (OPTIONAL — klyvion/billing/, klyvion/config.py)
# -----------------------------------------------------------------------------
# OFF by default: when disabled, synthesis is open and unmetered exactly as
# above. Full setup guide: docs/STRIPE_SETUP.md. See also docs/BILLING.md.

# Master switch. 1 = meter synthesis: every /synthesize requires a logged-in
# session and debits token credits (HTTP 402 when the balance runs out).
# 0 = open, anonymous, unmetered (the public-demo default).
KLYVION_BILLING_ENABLED=0

# Starter credits granted to each brand-new account on registration.
KLYVION_SIGNUP_CREDITS=5000

# Credits charged per character synthesized (cost = len(text) * this).
KLYVION_TOKENS_PER_CHAR=1

# ISO currency code used for Stripe checkout (e.g. usd, eur, gbp).
KLYVION_CURRENCY=usd

# --- Stripe payments (OPTIONAL) ----------------------------------------------
# Leave the secret key blank to run metering WITHOUT a way to buy more credits
# (the UI hides its buy buttons). To sell top-ups, create a Stripe account and
# paste your keys below. THESE ARE REAL SECRETS — keep them out of version
# control. Use TEST keys (sk_test_/pk_test_) in development; card
# 4242 4242 4242 4242 completes a payment without moving money. Swap to LIVE
# keys (sk_live_/pk_live_) only in production. Full walkthrough: docs/STRIPE_SETUP.md
# KLYVION_STRIPE_SECRET_KEY=sk_test_xxx
# KLYVION_STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# Webhook signing secret used to verify Stripe callbacks. In local dev, run
#   stripe listen --forward-to localhost:8000/billing/webhook
# and copy the "whsec_..." value it prints. In production, copy it from the
# webhook endpoint you create in the Stripe dashboard.
# KLYVION_STRIPE_WEBHOOK_SECRET=whsec_xxx

# NOTE: KLYVION_PUBLIC_BASE_URL (in the auth section above) is also used to
# build the checkout success/cancel return URLs — set it in production.

# -----------------------------------------------------------------------------
# Third-party / model licensing
# -----------------------------------------------------------------------------

# Coqui XTTS downloads its model on first use and requires ToS agreement.
# Setting this to 1 auto-accepts the Coqui Public Model License (non-commercial
# for the *model weights*). Only set this if you accept those terms.
COQUI_TOS_AGREED=0
